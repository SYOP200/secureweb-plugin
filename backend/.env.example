# Server Configuration
PORT=3000
NODE_ENV=production

# Security
WEBHOOK_SECRET=your-webhook-secret-key-here

# Database (if you add database persistence)
# DATABASE_URL=postgresql://user:password@localhost:5432/secureweb

# Redis (for rate limiting and caching)
# REDIS_URL=redis://localhost:6379

# API Configuration
API_RATE_LIMIT=1000
API_RATE_WINDOW=900000

# Logging
LOG_LEVEL=info